# ===============================================================
# MockMate AI — Full-Stack Single Container Production for Vercel
# Multi-Stage Build: React 19 Frontend + Java 17 Spring Boot Backend
# Based on Durgesh (Learn Code With Durgesh) Vercel Containerization
# ===============================================================

# --- Stage 1: Build React Frontend ---
FROM node:20-alpine AS frontend-builder
WORKDIR /app/frontend

COPY frontend/package*.json ./
RUN npm ci

COPY frontend/ ./
RUN npm run build

# --- Stage 2: Build Spring Boot JAR with Built Frontend Assets ---
FROM eclipse-temurin:17-jdk-jammy AS backend-builder
WORKDIR /app

RUN apt-get update && apt-get install -y maven && rm -rf /var/lib/apt/lists/*

COPY pom.xml .
COPY src ./src

# Copy built frontend assets into Spring Boot's static resources
COPY --from=frontend-builder /app/frontend/dist/ ./src/main/resources/static/

RUN mvn clean package -DskipTests

# --- Stage 3: Lightweight Production JRE for Vercel Fluid Compute ---
FROM eclipse-temurin:17-jre-jammy
WORKDIR /app

# Non-root user for security best practices
RUN groupadd -r spring && useradd -r -g spring spring
USER spring

COPY --from=backend-builder --chown=spring:spring /app/target/mockmate-java-1.0.0.jar app.jar

ENV PORT=8080
EXPOSE 8080

# Tuned JVM parameters for Vercel Fluid compute (lightweight serial GC + stack tuning)
ENTRYPOINT ["sh", "-c", "java -Xmx320m -Xss512k -XX:+UseSerialGC -Dserver.port=${PORT} -Dserver.address=0.0.0.0 -Djava.security.egd=file:/dev/./urandom -jar app.jar"]
